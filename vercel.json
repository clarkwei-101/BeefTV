{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "cd web && bun install --frozen-lockfile",
    "buildCommand": "cd web && bun run build",
    "outputDirectory": "web/dist",
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://bogged-scoff-compare.ngrok-free.dev/api/$1",
            "headers": {
                "x-vercel-enable-rewrite-caching": "0",
                "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "Vercel-CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "x-vercel-cache": "0"
            },
            "transforms": [
                {
                    "type": "request.headers",
                    "op": "set",
                    "target": {
                        "key": "ngrok-skip-browser-warning"
                    },
                    "args": "1"
                }
            ]
        },
        {
            "src": "/build-stamp.json",
            "dest": "/build-stamp.json",
            "headers": {
                "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "Vercel-CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "x-vercel-cache": "0"
            }
        },
        {
            "src": "/",
            "dest": "/index.html",
            "headers": {
                "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "Vercel-CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "x-vercel-cache": "0"
            }
        },
        {
            "src": "/index.html",
            "dest": "/index.html",
            "headers": {
                "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "Vercel-CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "x-vercel-cache": "0"
            }
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/static/(.*)",
            "status": 404,
            "headers": {
                "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/index.html",
            "headers": {
                "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "Vercel-CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "CDN-Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
                "x-vercel-cache": "0"
            }
        }
    ]
}
