# ─── BeefTV Public Deployment — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Shared proxy token ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# This secret is sent by the Go backend as "Authorization: Bearer <token>"
# to authenticate against the beeftv_proxy.py model bridge.
BEEFTV_PROXY_TOKEN=

# ── Data directory ─────────────────────────────────────────────────────────────
# Must be an absolute path; never use "backend/data" for production.
BEEFTV_DATA=/Users/yahweh/Desktop/ai%E5%BA%94%E7%94%A8%E7%A4%BE/.local/project-workbench-debug

# ── Ports ─────────────────────────────────────────────────────────────────────
BEEFTV_BACKEND_PORT=8080
BEEFTV_WEB_PORT=3000
BEEFTV_PROXY_PORT=8198

# ── Cloudflare ─────────────────────────────────────────────────────────────────
# Domain delegated to Cloudflare (e.g. cyber-foundation.com)
BEEFTV_PUBLIC_DOMAIN=beeftv.YOUR_DOMAIN.com

# ── Proxy CORS origins ─────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# In dev: http://localhost:3000
# In prod (Cloudflare Tunnel): https://beeftv.YOUR_DOMAIN.com
BEEFTV_PROXY_ALLOWED_ORIGINS=http://localhost:3000
